[Unit]
Description=Crypto Bank Vault frontend (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/crypto-bank/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5
# Limitar exposición: solo loopback vía -H 127.0.0.1

[Install]
WantedBy=multi-user.target
