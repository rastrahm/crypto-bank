# Copiar a .env.local tras el deploy (Anvil / testnet)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_VAULT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Monedas del select: SYM:native[:decimals] | SYM:0xToken[:decimals] (coma-separadas)
# Decimals opcional (default 18). Ej. USDC:0x...:6
# Ejemplo Anvil (primer deploy; regenerar addresses si redeployás):
NEXT_PUBLIC_ASSETS=ETH:native,mUSD:0x5FbDB2315678afecb367f032d93F642f64180aa3:18
